# Copy this file to ".env" (same folder) and fill it in. ".env" is ignored by Git.
# NEVER paste the real values into chat, issues, or committed files.

# Supabase: click "Connect" at the top of your project, choose "Session pooler",
# copy the string, and replace [YOUR-PASSWORD] with your database password.
# It looks like: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# If the password has special characters (@ : / # ? %), percent-encode them, or reset it to letters and numbers.
DATABASE_URL=

# Port for the API on your computer.
PORT=3001

# Browser addresses allowed to call the API (comma-separated). Add the GitHub Pages address at go-live.
CORS_ORIGINS=http://localhost:5173

# Optional hardening for go-live (Task 11): path to Supabase's CA certificate file
# (Project Settings > Database > SSL Configuration) to fully verify the database's identity.
# DB_SSL_CA_PATH=

# Sign-in. JWT_SECRET signs the tokens that keep you signed in. Make it long and random (at least 32 characters), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Passwords (at least 10 characters). The name ends with the username in capitals.
# After changing one, run: npm run auth:sync   (it saves a scrambled copy in the database and signs that person out everywhere)
RADAR_PASSWORD_AVCKIRAN=
RADAR_PASSWORD_KOARORA6=

# Number of proxies in front of the API on your host (usually 1 once deployed, 0 on your computer).
# TRUST_PROXY=0
