# Optional. Copy to ".env.local" to override defaults. The frontend holds NO secrets: only public addresses.

# Address of the RADAR API. Defaults to http://localhost:3001 in development.
# For the published site this is set as a GitHub repository variable (see docs/tasks/task-0-hello-world.md).
# VITE_API_URL=http://localhost:3001

# Path the site is served from. "/" for avckiran.github.io, "/radar/" for avckiran.github.io/radar/.
# VITE_BASE=/
